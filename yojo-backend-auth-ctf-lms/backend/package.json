{
  "name": "yojo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Yojo Cyber Academy backend (Milestone 1: Foundation)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:worker": "node dist/worker.js",
    "pages": "node scripts/dev-pages-server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node --transpile-only prisma/seed.ts",
    "db:bootstrap-admin": "ts-node --transpile-only scripts/bootstrap-admin.ts",
    "openapi": "ts-node --transpile-only scripts/export-openapi.ts",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:e2e": "jest --config jest.config.js --selectProjects e2e --runInBand",
    "test:all": "jest --config jest.config.js --runInBand"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.3",
    "argon2": "0.44.0",
    "bullmq": "5.61.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "ioredis": "5.8.1",
    "jose": "5.10.0",
    "nestjs-pino": "4.4.1",
    "pino": "9.13.1",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@nestjs/testing": "11.2.7",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.8",
    "@types/supertest": "6.0.3",
    "eslint": "9.37.0",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "pino-pretty": "13.1.1",
    "prettier": "3.6.2",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
