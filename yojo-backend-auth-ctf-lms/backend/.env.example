# Yojo backend · Milestone 1 · example local configuration.
# Copy to .env for local development. NEVER commit .env. Production values come from the secrets manager.

NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=info

# Local Docker Compose services (docker compose up -d). Dev-only credentials, not secrets.
DATABASE_URL=postgresql://yojo:yojo_local_dev@127.0.0.1:5432/yojo_dev?schema=public
REDIS_URL=redis://127.0.0.1:6379/0
# Optional separate Redis for BullMQ (spec §21). Defaults to REDIS_URL.
# REDIS_QUEUE_URL=redis://127.0.0.1:6379/1

# Generate your own, never reuse these placeholders:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
FIELD_ENCRYPTION_KEY_ID=local-1
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
OTP_HMAC_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# Front-end origin used in emailed links (invite, password reset, MFA re-enrolment).
PUBLIC_APP_URL=http://localhost:8000
# Comma-separated organisation domains allowed for staff accounts.
STAFF_EMAIL_DOMAINS=yojosolutions.com

# Plain-HTTP local development cannot use __Host- cookies. Must be true everywhere else.
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HOPS=1
# Interactive API docs at /api/docs (refused when NODE_ENV=production).
SWAGGER_ENABLED=true
CORS_DISABLED=true

# Mail: "dev" writes each email as JSON into DEV_MAIL_DIR (read OTPs and invite links there).
# A real provider (OD-11) is added when credentials exist; production refuses "dev".
MAIL_DRIVER=dev
DEV_MAIL_DIR=.dev-mail
MAIL_FROM="Yojo Cyber Academy <no-reply@example.invalid>"

# Team inbox that gets a short alert (reference and form name only) for each new website enquiry. Optional.
# ENQUIRY_NOTIFY_EMAIL=enquiries@yojosolutions.com

# Google sign-in stays disabled (503 GOOGLE_NOT_CONFIGURED) until a client ID exists.
# GOOGLE_CLIENT_ID=

# Session lifetimes in minutes [PROVISIONAL, spec §6.5 / OD-24].
SESSION_IDLE_STUDENT_MIN=10080
SESSION_ABSOLUTE_STUDENT_MIN=43200
SESSION_IDLE_STAFF_MIN=30
SESSION_ABSOLUTE_STAFF_MIN=720
